{
	admin off
}

localhost {
	encode zstd gzip

	request_body {
		max_size 1MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		Content-Security-Policy "default-src 'none'; script-src 'self' https://checkout.razorpay.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.razorpay.com https://lumberjack.razorpay.com; frame-src https://api.razorpay.com https://checkout.razorpay.com; form-action 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'"
		-Server
	}

	reverse_proxy {$API_UPSTREAM}
}
